                </mxCell>
                <mxCell id="ryu" parent="vm" style="swimlane;startSize=30;fillColor=#FFE6CC;strokeColor=#D79B00;html=1;fontStyle=1;" value="SDN controller (Ryu) — the traffic cop" vertex="1">
                    <mxGeometry height="560" width="220" x="920" y="50" as="geometry"/>
                </mxCell>
                <mxCell id="r1" parent="ryu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" value="&lt;b&gt;Connects to all switches&lt;/b&gt;&#xa;watches traffic every 5s" vertex="1">
                    <mxGeometry height="70" width="190" x="15" y="45" as="geometry"/>
                </mxCell>
                <mxCell id="r2" parent="ryu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" value="&lt;b&gt;New switch joins&lt;/b&gt;&#xa;teaches it to ask the&#xa;controller what to do" vertex="1">
                    <mxGeometry height="55" width="190" x="15" y="125" as="geometry"/>

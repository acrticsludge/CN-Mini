                <mxCell id="h3" parent="mn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=8;" value="&lt;b&gt;h3 — Main backup server&lt;/b&gt;&#xa;receives the file pieces,&#xa;double-checks each one,&#xa;then stores them safely" vertex="1">

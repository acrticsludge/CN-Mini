                <mxCell id="r3" parent="ryu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" value="&lt;b&gt;Listens for link changes&lt;/b&gt;&#xa;hears when a cable goes&#xa;down or comes back up" vertex="1">

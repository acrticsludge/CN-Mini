                </mxCell>
                <mxCell id="h4" parent="mn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;spacingLeft=8;" value="&lt;b&gt;h4 — Spare backup server&lt;/b&gt;&#xa;client switches to this one&#xa;if the main server is unreachable" vertex="1">

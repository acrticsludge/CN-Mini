                <mxCell id="r4" parent="ryu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" value="&lt;b&gt;Rebuilds the map&lt;/b&gt;&#xa;draws the network again&#xa;with the latest link states" vertex="1">
                    <mxGeometry height="65" width="190" x="15" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="r5" parent="ryu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" value="&lt;b&gt;Picks the shortest path&lt;/b&gt;&#xa;fewest hops between each&#xa;client and server" vertex="1">
                    <mxGeometry height="70" width="190" x="15" y="380" as="geometry"/>
                </mxCell>
                <mxCell id="r6" parent="ryu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;spacingLeft=8;" value="&lt;b&gt;Updates the switches&lt;/b&gt;&#xa;removes old routes,&#xa;installs the new ones" vertex="1">
                    <mxGeometry height="70" width="190" x="15" y="475" as="geometry"/>
                </mxCell>
                <mxCell id="e_r3_r4" edge="1" parent="ryu" source="r3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" target="r4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_r4_r5" edge="1" parent="ryu" source="r4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" target="r5">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_r5_r6" edge="1" parent="ryu" source="r5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" target="r6">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="proto" parent="vm" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFFFFF;strokeColor=#999999;fontSize=12;" value="&lt;b&gt;How a backup works, step by step&lt;/b&gt;&#xa;&lt;br&gt;&#xa;1. Client: &amp;quot;Hello, here comes report.pdf (5 MB)&amp;quot;&#xa;&lt;br&gt;2. Server: &amp;quot;Ready, send it&amp;quot;&#xa;&lt;br&gt;3. Client chops the file into 8 KB pieces and sends them one by one, each piece with a checksum attached&#xa;&lt;br&gt;4. Server re-checks the checksum: &amp;quot;got piece #12, next&amp;quot; — a corrupted piece is thrown away and never counted&#xa;&lt;br&gt;5. When every piece is stored, the transfer is complete&#xa;&lt;br&gt;&#xa;&lt;b&gt;If the transfer is interrupted&lt;/b&gt; (e.g. a link is cut): the client reconnects and says &amp;quot;continue from piece #12&amp;quot; — nothing already sent is repeated.&#xa;&lt;br&gt;&#xa;&lt;i&gt;Nerdy details: custom binary messages over one TCP connection; CRC32 checksum per piece.&lt;/i&gt;" vertex="1">
                    <mxGeometry height="220" width="1110" x="25" y="628" as="geometry"/>
                </mxCell>
                <mxCell id="e_browser_flask" edge="1" parent="vm" source="browser" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" target="flask" value="clicks, sees status">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_flask_shared" edge="1" parent="vm" source="flask" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" target="shared" value="drops jobs, reads progress">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_shared_h1" edge="1" parent="vm" source="shared" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=classic;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" target="h1" value="jobs out, progress back">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_shared_linkctl" edge="1" parent="vm" source="shared" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;dashed=1;strokeColor=#B85450;fontSize=11;labelBackgroundColor=#ffffff;" target="linkctl" value="&amp;quot;cut this link&amp;quot;">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

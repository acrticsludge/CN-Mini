                <mxCell id="h2" parent="mn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=8;" value="&lt;b&gt;h2 — Extra client&lt;/b&gt;&#xa;spare client you can&#xa;run by hand for testing" vertex="1">

                <mxCell id="sw" parent="mn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" value="&lt;b&gt;Switches s1–s4&lt;/b&gt;&#xa;all wired to each other&#xa;no traffic flows unless the&#xa;controller says so" vertex="1">

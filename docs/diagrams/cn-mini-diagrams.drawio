                <mxCell id="h1" parent="mn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;spacingLeft=8;" value="&lt;b&gt;h1 — Client&lt;/b&gt;&#xa;reads new jobs from&#xa;shared_files/ and sends&#xa;the file to a backup server" vertex="1">
